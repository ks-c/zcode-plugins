{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "${ZCODE_PLUGIN_ROOT}/hooks/chime.exe",
            "args": ["--event", "permission"],
            "timeoutMs": 10000,
            "statusMessage": "playing attention chime"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "process",
            "command": "${ZCODE_PLUGIN_ROOT}/hooks/chime.exe",
            "args": ["--event", "question"],
            "timeoutMs": 10000,
            "statusMessage": "playing attention chime"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "${ZCODE_PLUGIN_ROOT}/hooks/chime.exe",
            "args": ["--event", "stop"],
            "timeoutMs": 10000,
            "statusMessage": "playing attention chime"
          }
        ]
      }
    ]
  }
}